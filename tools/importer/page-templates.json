        {
          "id": "conversion",
          "name": "conversion",
          "selector": [
            ".conversion",
            "#content > div"
          ],
          "style": "dark",
          "blocks": [
            "hero-video"
          ],
          "defaultContent": []
        }
      ]
    }
  ]
}